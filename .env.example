# Copied to .env by `python scripts/bootstrap.py init` (which also fills SECRET_KEY).
# Upstox API key/secret live in config/credentials.json, not here.

# Orchestrator profile: "trading" runs only the trading stack (no NSE bhavcopy,
# no research books). The repository owner's research stack is "full".
NIFTY_PROFILE=trading

# Flask dashboard
SECRET_KEY=change-me
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# Optional — Telegram alerts (orchestrator start/stop, token requests, failed jobs).
# Leave blank to disable; every sender no-ops without them.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Optional — approve the daily Upstox token from your phone instead of a browser
# login. Needs a free ngrok static domain; see README "Phone approval".
# bootstrap init generates the secret; phone approval stays off until the domain is set.
UPSTOX_NOTIFY_DOMAIN=
UPSTOX_NOTIFY_SECRET=
# NGROK_PATH=/opt/homebrew/bin/ngrok   # only if ngrok is not on PATH
